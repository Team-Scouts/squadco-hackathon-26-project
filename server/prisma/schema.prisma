// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

enum VendorStatus {
  PENDING
  VERIFIED
  REVIEW
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  DEVICE_REUSE
  DUPLICATE_DOCUMENT
  SUSPICIOUS_TRANSACTION
  FRAUD_RING
}

enum DocumentVerificationStatus {
  PENDING
  NEEDS_REVIEW
  VERIFIED
  REJECTED
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String?
  role     String  @default("user")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Vendor {
  id           String @id @default(uuid())
  businessName String
  email        String @unique
  phone        String

  status VendorStatus @default(PENDING)

  overallRiskScore Float     @default(0)
  riskLevel        RiskLevel @default(LOW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents    Document[]
  devices      Device[]
  transactions Transaction[]
  alerts       Alert[]
  bankAccounts BankAccount[]
  transfers    Transfer[]
  riskScores   RiskScore[]
}

model Document {
  id String @id @default(uuid())

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  documentType String
  fileUrl      String

  documentHash String?
  tamperScore  Float   @default(0)

  verificationStatus   DocumentVerificationStatus @default(PENDING)
  duplicateDetected    Boolean                    @default(false)
  duplicateVendorCount Int                        @default(0)
  extractedFields      Json?
  verificationReasons  Json?
  reviewNotes          String?
  verifiedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([documentHash])
  @@index([verificationStatus])
}

model Device {
  id String @id @default(uuid())

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  deviceHash String
  ipAddress  String
  browser    String
  timezone   String

  riskScore Float @default(0)

  createdAt DateTime @default(now())
}

model Transaction {
  id String @id @default(uuid())

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  transactionRef String @unique

  amount  Float
  channel String
  status  String

  financialRiskScore Float @default(0)

  createdAt DateTime @default(now())

  webhookEvents WebhookEvent[]
}

model BankAccount {
  id String @id @default(uuid())

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  bankCode           String
  bankName           String
  accountNumberHash  String
  accountNumberLast4 String
  accountName        String
  lookupStatus       String @default("PENDING")
  identityMatchScore Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transfers Transfer[]

  @@index([vendorId])
  @@index([accountNumberHash])
}

model Transfer {
  id String @id @default(uuid())

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  transferReference String @unique
  amount            Float
  currency          String @default("NGN")
  status            String
  rawPayload        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookEvents WebhookEvent[]

  @@index([vendorId])
  @@index([bankAccountId])
}

model WebhookEvent {
  id String @id @default(uuid())

  provider             String
  eventType            String
  transactionReference String?
  transferReference    String?
  rawPayload           Json
  signature            String?
  processed            Boolean   @default(false)
  processedAt          DateTime?

  graphSynced       Boolean @default(false)
  graphSyncAttempts Int     @default(0)
  graphSyncError    String?

  createdAt DateTime @default(now())

  transaction Transaction? @relation(fields: [transactionReference], references: [transactionRef])
  transfer    Transfer?    @relation(fields: [transferReference], references: [transferReference])

  @@index([provider])
  @@index([eventType])
  @@index([transactionReference])
  @@index([transferReference])
  @@index([graphSynced])
}

model RiskScore {
  id String @id @default(uuid())

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  documentRisk         Float     @default(0)
  networkFraudRisk     Float     @default(0)
  financialAnomalyRisk Float     @default(0)
  deviceRisk           Float     @default(0)
  identityMismatchRisk Float     @default(0)
  manualReviewPenalty  Float     @default(0)
  overallRisk          Float     @default(0)
  riskLevel            RiskLevel
  recommendedAction    String
  reasons              Json

  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([riskLevel])
}

model GraphSyncFailure {
  id String @id @default(uuid())

  entityType String
  entityId   String?
  operation  String
  error      String
  retryCount Int     @default(0)
  resolved   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([resolved])
}

model Alert {
  id String @id @default(uuid())

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  type    AlertType
  message String

  resolved Boolean @default(false)

  createdAt DateTime @default(now())
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
